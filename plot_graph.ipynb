import pandas as pd
import matplotlib.pyplot as plt
import numpy as np
df = pd.read_excel("/content/dummy.xlsx")
df["Date"] = pd.to_datetime(df["Date"])

# 1. Line Chart
plt.figure(figsize=(10, 5))
plt.plot(df["Date"], df["Revenue"], marker="o")
plt.title("Revenue Trend Over Time")
plt.xlabel("Date")
plt.ylabel("Revenue")
plt.xticks(rotation=45)
plt.grid(True)
plt.tight_layout()
plt.show()

# 2. Bar Chart
product_revenue = df.groupby("Product")["Revenue"].sum()
plt.figure(figsize=(8, 5))
product_revenue.plot(kind="bar")
plt.title("Total Revenue by Product")
plt.xlabel("Product")
plt.ylabel("Total Revenue")
plt.xticks(rotation=45)
plt.tight_layout()
plt.show()

# 3. Pie Chart
region_revenue = df.groupby("Region")["Revenue"].sum()
plt.figure(figsize=(7, 7))
plt.pie(region_revenue, labels=region_revenue.index, autopct="%1.1f%%", startangle=90)
plt.title("Revenue Share by Region")
plt.tight_layout()
plt.show()

# 4. Scatter Plot
plt.figure(figsize=(8, 5))
plt.scatter(df["Units_Sold"], df["Revenue"])
plt.title("Units Sold vs Revenue")
plt.xlabel("Units Sold")
plt.ylabel("Revenue")
plt.grid(True)
plt.tight_layout()
plt.show()

# 5. Histogram
plt.figure(figsize=(8, 5))
plt.hist(df["Revenue"], bins=10, edgecolor="black")
plt.title("Distribution of Revenue")
plt.xlabel("Revenue")
plt.ylabel("Frequency")
plt.tight_layout()
plt.show()

# 6. Box Plot
plt.figure(figsize=(8, 5))
df.boxplot(column="Revenue", by="Product")
plt.title("Revenue Distribution by Product")
plt.suptitle("")
plt.xlabel("Product")
plt.ylabel("Revenue")
plt.xticks(rotation=45)
plt.tight_layout()
plt.show()

# 7. Stacked Bar Chart
stacked_data = df.pivot_table(
    values="Units_Sold",
    index="Product",
    columns="Region",
    aggfunc="sum"
)
stacked_data.plot(kind="bar", stacked=True, figsize=(10, 6))
plt.title("Units Sold by Product and Region")
plt.xlabel("Product")
plt.ylabel("Units Sold")
plt.xticks(rotation=45)
plt.legend(title="Region")
plt.tight_layout()
plt.show()

# 8. Area Chart
date_revenue = df.groupby("Date")["Revenue"].sum()
plt.figure(figsize=(10, 5))
plt.fill_between(date_revenue.index, date_revenue.values, alpha=0.5)
plt.plot(date_revenue.index, date_revenue.values, marker="o")
plt.title("Revenue Area Chart Over Time")
plt.xlabel("Date")
plt.ylabel("Revenue")
plt.xticks(rotation=45)
plt.grid(True)
plt.tight_layout()
plt.show()

# 9. Correlation Heatmap
numeric_df = df[["Units_Sold", "Revenue", "Customer_Rating"]]
corr = numeric_df.corr()

plt.figure(figsize=(6, 5))
plt.imshow(corr)
plt.colorbar()

plt.xticks(range(len(corr.columns)), corr.columns, rotation=45)
plt.yticks(range(len(corr.columns)), corr.columns)

for i in range(len(corr.columns)):
    for j in range(len(corr.columns)):
        plt.text(j, i, round(corr.iloc[i, j], 2), ha="center", va="center")

plt.title("Correlation Heatmap")
plt.tight_layout()
plt.show()

# 10. Bubble Chart
plt.figure(figsize=(8, 5))
bubble_size = df["Customer_Rating"] * 100

plt.scatter(
    df["Units_Sold"],
    df["Revenue"],
    s=bubble_size,
    alpha=0.6
)

plt.title("Bubble Chart: Units Sold vs Revenue")
plt.xlabel("Units Sold")
plt.ylabel("Revenue")
plt.grid(True)
plt.tight_layout()
plt.show()
