import pandas as pd

# Load the dataset
df = pd.read_csv("Social_Media_Sentiment_Analysis_AI_Trends_2026.csv")

# 1. head()
print("1. First 5 Records")
print(df.head())

# 2. tail()
print("\n2. Last 5 Records")
print(df.tail())

# 3. info()
print("\n3. Dataset Information")
df.info()

# 4. describe()
print("\n4. Descriptive Statistics")
print(df.describe())

# 5. sample()
print("\n5. Random Sample of 5 Records")
print(df.sample(5))

# 6. isnull()
print("\n6. Missing Values")
print(df.isnull().sum())

# 7. duplicated()
print("\n7. Number of Duplicate Rows")
print(df.duplicated().sum())

# 8. nunique()
print("\n8. Unique Values in Each Column")
print(df.nunique())

# 9. value_counts()
print("\n9. Sentiment Label Counts")
print(df["sentiment_label"].value_counts())

# 10. sort_values()
print("\n10. Top 10 Posts by Engagement Score")
print(df.sort_values(by="engagement_score", ascending=False).head(10))

# 11. groupby()
print("\n11. Average Engagement Score by Platform")
print(df.groupby("platform")["engagement_score"].mean())

# 12. agg()
print("\n12. Aggregate Statistics")
print(
    df.groupby("platform").agg({
        "like_count": ["mean", "max"],
        "comment_count": ["mean", "max"],
        "engagement_score": ["mean", "max"]
    })
)

# 13. query()
print("\n13. Positive Sentiment Posts")
print(df.query("sentiment_label == 'Positive'").head())

# 14. corr()
print("\n14. Correlation Matrix")
print(df.select_dtypes(include="number").corr())

# 15. drop_duplicates()
print("\n15. Dataset After Removing Duplicates")
df_no_duplicates = df.drop_duplicates()
print("Original Shape:", df.shape)
print("New Shape:", df_no_duplicates.shape)
