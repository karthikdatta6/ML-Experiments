import pandas as pd
from sklearn.datasets import load_iris
# ---------------------------------------------------------
# Load and prepare the Iris dataset
# ---------------------------------------------------------
iris = load_iris(as_frame=True)
df = iris.frame.copy()
df.rename(
 columns={
 "sepal length (cm)": "sepal_length",
 "sepal width (cm)": "sepal_width",
 "petal length (cm)": "petal_length",
 "petal width (cm)": "petal_width"
 },
 inplace=True
)
target_mapping = {
 0: "setosa",
 1: "versicolor",
 2: "virginica"
}
df["species"] = df["target"].map(target_mapping)
df.drop(columns=["target"], inplace=True)
def display_section(number, title):
 """Display a formatted heading for each operation."""
 print("\n" + "=" * 70)
 print(f"{number}. {title}")
 print("=" * 70)

 # 1. head()
display_section(1, "First Five Records Using head()")
print(df.head())
# 2. tail()
display_section(2, "Last Five Records Using tail()")
print(df.tail())
# 3. info()
display_section(3, "DataFrame Information Using info()")
df.info()
# 4. describe()
display_section(4, "Descriptive Statistics Using describe()")
print(df.describe())
# 5. sample()
display_section(5, "Random Records Using sample()")
print(df.sample(n=5, random_state=42))
# 6. isnull()
display_section(6, "Missing-Value Analysis Using isnull()")
print(df.isnull().sum())
print("Total missing values:", df.isnull().sum().sum())
# 7. duplicated()
display_section(7, "Duplicate-Record Analysis Using duplicated()")
print("Number of duplicate rows:", df.duplicated().sum())
print("\nDuplicate records:")
print(df[df.duplicated()])
# 8. nunique()
display_section(8, "Unique-Value Counts Using nunique()")
print(df.nunique())
# 9. value_counts()
display_section(9, "Species Frequency Using value_counts()")
print(df["species"].value_counts())
# 10. sort_values()
display_section(10, "Sorting Data Using sort_values()")
sorted_df = df.sort_values(
 by="sepal_length",
 ascending=False
)
print(sorted_df.head(10))
# 11. groupby()
display_section(11, "Species-Wise Mean Using groupby()")
grouped_mean = df.groupby("species").mean()
print(grouped_mean)
# 12. agg()
display_section(12, "Multiple Statistical Operations Using agg()")
aggregated_result = df.groupby("species").agg(
 {
 "sepal_length": ["mean", "min", "max"],
 "sepal_width": ["mean", "min", "max"],
 "petal_length": ["mean", "min", "max"],
 "petal_width": ["mean", "min", "max"]
 }
)
print(aggregated_result)
# 13. query()
display_section(13, "Conditional Filtering Using query()")
filtered_df = df.query(
 "petal_length > 5.0 and sepal_length > 6.0"
)
print(filtered_df)
# 14. corr()
display_section(14, "Correlation Matrix Using corr()")
numerical_df = df.select_dtypes(include="number")
correlation_matrix = numerical_df.corr()
print(correlation_matrix)
# 15. drop_duplicates()
display_section(15, "Removing Duplicate Records Using drop_duplicates()")
cleaned_df = df.drop_duplicates()
print("Original shape:", df.shape)
print("Cleaned shape:", cleaned_df.shape)
print("\nCleaned DataFrame:")
print(cleaned_df.head())


print("Number of original rows:", df.shape[0])
print("Number of columns:", df.shape[1])
print("Column names:", list(df.columns))
print("Species categories:", df["species"].unique())
print("Total missing values:", df.isnull().sum().sum())
print("Total duplicate rows:", df.duplicated().sum())
